# ==============================================================================
# AQUILA Frontend Client Environment Template (React / Vite)
# System: Distributed Multi-Agent Decision Support System (BPSU BSCS 2026)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TRANSACTIONAL REST API (PHP Backend on XAMPP)
# ------------------------------------------------------------------------------
# Must point to the public front controller endpoint of backend-api.
# Default local loopback: http://127.0.0.1/aquila-system/backend-api/public/api/v1
VITE_API_BASE_URL=http://127.0.0.1/aquila-system/backend-api/public/api/v1

# ------------------------------------------------------------------------------
# 2. CLOUD HOT STORE & MAS BLACKBOARD (Firebase Realtime Database)
# ------------------------------------------------------------------------------
# Region: Singapore (asia-southeast1)
# Used for real-time sensor node telemetry (/nodes) and agent hypotheses (/blackboard)
VITE_FIREBASE_DATABASE_URL=https://aquila-system-default-rtdb.asia-southeast1.firebasedatabase.app